// Tables follow "Toodle Store — New Website Plan", Database section.
// All money columns are integers in paise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. scripts/build.mjs falls back to DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Customers & auth ────────────────────────────────────────────

enum AuthProvider {
  email_otp
  google
}

model User {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  phone        String?
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @map("auth_provider")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastLoginAt  DateTime?    @map("last_login_at")

  sessions  Session[]
  addresses Address[]
  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]
  reviews   Review[]

  @@map("users")
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  otpHash   String    @map("otp_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("otp_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Address {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  name      String
  phone     String
  pincode   String
  city      String
  state     String
  line1     String
  line2     String?
  landmark  String?
  isDefault Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── Catalogue ───────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  parentId       String?  @map("parent_id")
  description    String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  image          String?
  color          String   @default("blue")
  sortOrder      Int      @default(0) @map("sort_order")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@map("categories")
}

model AgeGroup {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  minAgeMonths   Int     @map("min_age_months")
  maxAgeMonths   Int?    @map("max_age_months")
  description    String?
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  color          String  @default("blue")

  products ProductAgeGroup[]

  @@map("age_groups")
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?

  products Product[]

  @@map("brands")
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  sku            String        @unique
  description    String
  highlights     String[]      @default([])
  material       String?
  safetyInfo     String?       @map("safety_info")
  dimensions     String?
  mrp            Int
  salePrice      Int           @map("sale_price")
  stockQty       Int           @default(0) @map("stock_qty")
  brandId        String?       @map("brand_id")
  gstRate        Int           @default(18) @map("gst_rate")
  hsnCode        String?       @map("hsn_code")
  weightGrams    Int?          @map("weight_grams")
  status         ProductStatus @default(active)
  isBestSeller   Boolean       @default(false) @map("is_best_seller")
  isNewArrival   Boolean       @default(false) @map("is_new_arrival")
  isDeal         Boolean       @default(false) @map("is_deal")
  isB2bVisible   Boolean       @default(true) @map("is_b2b_visible")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  brand      Brand?            @relation(fields: [brandId], references: [id])
  categories ProductCategory[]
  ageGroups  ProductAgeGroup[]
  images     ProductImage[]
  cartItems  CartItem[]
  wishlists  WishlistItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([status])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductAgeGroup {
  productId  String @map("product_id")
  ageGroupId String @map("age_group_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ageGroup AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)

  @@id([productId, ageGroupId])
  @@map("product_age_groups")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  url       String
  altText   String @map("alt_text")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── Cart & wishlist ─────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique @map("user_id")
  sessionId  String?  @unique @map("session_id")
  couponCode String?  @map("coupon_code")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String @map("cart_id")
  productId String @map("product_id")
  qty       Int
  price     Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model WishlistItem {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlists")
}

// ─── Orders & payments ───────────────────────────────────────────

enum PaymentMethod {
  razorpay
  cod
}

enum OrderStatus {
  pending_payment
  cod_enquiry
  placed
  packed
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique @map("order_number")
  userId        String        @map("user_id")
  email         String
  phone         String
  address       Json
  subtotal      Int
  discount      Int           @default(0)
  shipping      Int           @default(0)
  gst           Int
  total         Int
  paymentMethod PaymentMethod @map("payment_method")
  status        OrderStatus
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  couponCode    String?       @map("coupon_code")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  shipment Shipment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String? @map("product_id")
  name      String
  image     String?
  qty       Int
  unitPrice Int     @map("unit_price")
  gst       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  amount            Int
  status            PaymentStatus @default(unpaid)
  method            String?
  rawWebhook        Json?         @map("raw_webhook")
  createdAt         DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  paymentId        String   @map("payment_id")
  razorpayRefundId String?  @unique @map("razorpay_refund_id")
  amount           Int
  status           String
  createdAt        DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Shipment {
  orderId     String  @id @map("order_id")
  courier     String?
  awbNumber   String? @map("awb_number")
  trackingUrl String? @map("tracking_url")
  status      String  @default("pending")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

enum CouponType {
  percent
  flat
}

model Coupon {
  code       String     @id
  type       CouponType
  value      Int
  minOrder   Int        @default(0) @map("min_order")
  startsAt   DateTime?  @map("starts_at")
  expiresAt  DateTime?  @map("expires_at")
  usageLimit Int?       @map("usage_limit")
  usedCount  Int        @default(0) @map("used_count")
  isActive   Boolean    @default(true) @map("is_active")

  @@map("coupons")
}

enum ReviewStatus {
  pending
  approved
  hidden
}

model Review {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  userId    String       @map("user_id")
  rating    Int
  comment   String?
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ─── B2B ─────────────────────────────────────────────────────────

enum EnquiryStatus {
  new
  contacted
  quote_sent
  won
  lost
}

model B2bEnquiry {
  id             String        @id @default(cuid())
  fullName       String        @map("full_name")
  phone          String
  email          String
  businessName   String?       @map("business_name")
  businessType   String        @map("business_type")
  city           String
  state          String
  gstNumber      String?       @map("gst_number")
  categories     Json          @default("[]")
  estOrderValue  String?       @map("est_order_value")
  message        String?
  status         EnquiryStatus @default(new)
  assignedTo     String?       @map("assigned_to")
  notes          String?
  sourcePage     String?       @map("source_page")
  utmSource      String?       @map("utm_source")
  utmMedium      String?       @map("utm_medium")
  utmCampaign    String?       @map("utm_campaign")
  ip             String?
  createdAt      DateTime      @default(now()) @map("created_at")

  assignee AdminUser? @relation(fields: [assignedTo], references: [id])

  @@index([status])
  @@index([phone, createdAt])
  @@map("b2b_enquiries")
}

// ─── Site & admin ────────────────────────────────────────────────

model Redirect {
  oldUrl String @id @map("old_url")
  newUrl String @map("new_url")
  type   Int    @default(301)

  @@map("redirects")
}

model Banner {
  id        String  @id @default(cuid())
  eyebrow   String?
  title     String
  subtitle  String?
  ctaLabel  String  @map("cta_label")
  ctaHref   String  @map("cta_href")
  image     String
  theme     String  @default("blue")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("banners")
}

enum AdminRole {
  admin
  order_manager
  sales
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  role         AdminRole
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")

  enquiries B2bEnquiry[]

  @@map("admin_users")
}
