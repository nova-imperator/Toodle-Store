# Copy to .env and fill in. Never commit .env.

# Database (docker-compose.yml runs PostgreSQL on 5433)
DATABASE_URL="postgresql://toodle:toodle_local@localhost:5433/toodle_store?schema=public"
# Direct connection used by migrations. Same as DATABASE_URL locally; Neon on Vercel sets it automatically.
DATABASE_URL_UNPOOLED="postgresql://toodle:toodle_local@localhost:5433/toodle_store?schema=public"

# Approval/preview deployments only: shows login codes on screen and simulates payments
# when SMTP / Razorpay are not configured. Must be empty on the live site.
DEMO_MODE=""

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "true" only on the live production site. Anything else serves robots.txt "Disallow: /".
NEXT_PUBLIC_ALLOW_INDEXING=""

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=""
OTP_PEPPER=""

# Google sign-in (OAuth client id of type "Web application"). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Razorpay. Leave both empty in development to use mock payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP. Leave SMTP_HOST empty in development: emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Toodle Store <hello@toodlestore.in>"

# Comma-separated team addresses that receive B2B enquiry and COD alerts
TEAM_ALERT_EMAILS=""

# First admin account created by the seed script
SEED_ADMIN_EMAIL="admin@toodlestore.in"
SEED_ADMIN_PASSWORD=""
